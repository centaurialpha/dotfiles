#!/bin/bash
# Screen brightness, scroll changes it. dwm brightness keys run brightnessctl and
# then `pkill -RTMIN+7 dwmblocks`. Prints nothing without a backlight
. sb-lib

case $BLOCK_BUTTON in
4) brightnessctl -q -c backlight set 5%+ ;;
5) brightnessctl -q -c backlight set 5%- ;;
esac

line=$(brightnessctl -m -c backlight 2>/dev/null) || exit 0
percent=$(echo "$line" | cut -d, -f4)
pill "$DEVICE" "$(printf '')" "$percent"
