#!/bin/bash
# Battery icon by state plus percent, nothing without a battery (the MSI)
# Warns once per discharge below 10%
. sb-lib

for bat in /sys/class/power_supply/BAT*; do
	[ -e "$bat/capacity" ] && break
done
[ -e "$bat/capacity" ] || exit 0

read -r capacity <"$bat/capacity"
read -r status <"$bat/status"
warned="${XDG_RUNTIME_DIR:-/tmp}/sb-battery-warned"
color=$DEVICE

case $status in
Charging) glyph="" ;;
Full) glyph="" ;;
"Not charging") glyph="" ;;
*) glyph="" ;;
esac

if [ "$status" = Discharging ] && [ "$capacity" -le 10 ]; then
	glyph=""
	color=$FAIL
	[ -e "$warned" ] || { notify-send -u critical -t 30000 "Low battery" "$capacity% left"; : >"$warned"; }
else
	rm -f "$warned"
fi

pill "$color" "$(printf "$glyph")" "$capacity%"
