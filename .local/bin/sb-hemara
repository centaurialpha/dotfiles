#!/bin/bash
# One server icon per Hemara environment (prod, pre) from Gatus: light when up,
# red when down, grey when Gatus does not answer (away from home without Tailscale)
# Left click opens Gatus. Not named GROUPS because bash already uses that name
. sb-lib

URL="http://uptime.home"
ENVIRONMENTS=("Producción" "Preproducción")

[ "$BLOCK_BUTTON" = 1 ] && setsid -f xdg-open "$URL" >/dev/null 2>&1

json=$(curl -sf -m 5 "$URL/api/v1/endpoints/statuses?pageSize=1")
out=""
for group in "${ENVIRONMENTS[@]}"; do
	if [ -z "$json" ]; then
		color=$INACTIVE
	# Healthy if it has results and every endpoint's last one succeeded
	elif jq -e --arg g "$group" \
		'[.[] | select(.group == $g and (.results | length > 0)) | .results[-1].success]
		| length > 0 and all' <<<"$json" >/dev/null; then
		color=$OK
	else
		color=$FAIL
	fi
	out+="^c$color^$(printf '')"
done

printf '^b%s^ %s ^d^\n' "$BLOCK_BG" "$out"
