#!/bin/bash
# Docker: blue whale when running, grey outline when stopped, green while starting
# or stopping. Left click toggles it (no password thanks to the polkit rule)
# sb-listen redraws it when it changes from the terminal
. sb-lib

if [ "$BLOCK_BUTTON" = 1 ]; then
	if systemctl is-active -q docker.service; then
		# One at a time: polkit rejects a request with both units, and with the socket
		# alive any `docker` command starts the service again
		systemctl --no-ask-password stop docker.socket
		systemctl --no-ask-password stop docker.service
	else
		systemctl --no-ask-password start docker.service
	fi
fi

case $(systemctl is-active docker.service) in
active) icon "#2496ed" "$(printf '')" ;;
activating) icon "$LAYOUT" "$(printf '')" ;;
deactivating) icon "$LAYOUT" "$(printf '')" ;;
failed) icon "$FAIL" "$(printf '')" ;;
*) icon "$INACTIVE" "$(printf '')" ;;
esac
