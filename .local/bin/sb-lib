# Palette and helpers for the dwmblocks sb-* blocks, same as the qtile bar
# Scripts (bash, for printf \u) source it with `. sb-lib`, which searches PATH
BLOCK_BG="#2a2a2a"
TEXT="#e8e8e8"
INACTIVE="#555555"
OK="#e8e8e8"
FAIL="#e46876"
LAYOUT="#98bb6c"
DEVICE="#c0a36e"
MEDIA="#957fb8"

# Standalone icon: colored glyph on the grey block
icon() {
	printf '^b%s^^c%s^ %s ^d^\n' "$BLOCK_BG" "$1" "$2"
}

# Pill: colored icon and value, both on the grey block
pill() {
	printf '^b%s^^c%s^ %s ^c%s^%s ^d^\n' "$BLOCK_BG" "$1" "$2" "$TEXT" "$3"
}

# Redraw the block with that signal (from dwmblocks config.h)
refresh() {
	pkill -RTMIN+"$1" -x dwmblocks
}
