# Paleta y helpers de los bloques sb-* de dwmblocks, la misma de la barra de qtile.
# Los scripts (bash, por el printf de \u) la cargan con `. sb-lib`, que busca en el PATH.
BLOCK_BG="#2a2a2a"
TEXT="#e8e8e8"
INACTIVE="#555555"
OK="#e8e8e8"
FAIL="#e46876"
LAYOUT="#98bb6c"
DEVICE="#c0a36e"
MEDIA="#957fb8"

# Ícono suelto: glifo de color sobre el bloque gris.
icon() {
	printf '^b%s^^c%s^ %s ^d^\n' "$BLOCK_BG" "$1" "$2"
}

# Pastilla: ícono de color y valor, los dos sobre el bloque gris.
pill() {
	printf '^b%s^^c%s^ %s ^c%s^%s ^d^\n' "$BLOCK_BG" "$1" "$2" "$TEXT" "$3"
}

# Redibuja el bloque con esa señal (la de config.h de dwmblocks).
refresh() {
	pkill -RTMIN+"$1" -x dwmblocks
}
