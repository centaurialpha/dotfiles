#!/bin/bash
# Arch logo: blue, orange when updates need attention (kernel, or 30+ pending)
# Left click opens the launcher, middle click upgrades
. sb-lib

IMPORTANT=" linux linux-lts linux-zen "
PILE_UP=30
ARCH_BLUE="#1793d1"
ATTENTION="#ffa066"
# Last computed color, the launcher click reuses it instead of running checkupdates
cache="${XDG_RUNTIME_DIR:-/tmp}/sb-arch-color"
logo=$(printf '')

case $BLOCK_BUTTON in
1)
	setsid -f j4-dmenu-desktop --no-generic -x --dmenu="dmenu -i" \
		--usage-log="$HOME/.cache/j4-dmenu-desktop.log" >/dev/null 2>&1
	icon "$(cat "$cache" 2>/dev/null || echo "$ARCH_BLUE")" "$logo"
	exit 0
	;;
2)
	setsid -f st -e sh -c 'sudo pacman -Syu; read -p "Enter para cerrar" _; pkill -RTMIN+1 -x dwmblocks' \
		>/dev/null 2>&1
	;;
esac

# Each checkupdates line: "name old_version -> new_version"
mapfile -t pending < <(checkupdates 2>/dev/null | cut -d' ' -f1)
color=$ARCH_BLUE
if [ "${#pending[@]}" -ge "$PILE_UP" ]; then
	color=$ATTENTION
fi
for pkg in "${pending[@]}"; do
	[[ $IMPORTANT == *" $pkg "* ]] && color=$ATTENTION
done

echo "$color" >"$cache"
icon "$color" "$logo"
