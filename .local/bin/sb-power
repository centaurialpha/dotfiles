#!/bin/bash
# power-profiles-daemon mode: slow, medium or fast gauge. Left click cycles
# balanced, performance (if supported) and power-saver. sb-listen redraws it
# when the mode changes elsewhere
. sb-lib

if [ "$BLOCK_BUTTON" = 1 ]; then
	case $(powerprofilesctl get) in
	balanced) powerprofilesctl set performance 2>/dev/null || powerprofilesctl set power-saver ;;
	performance) powerprofilesctl set power-saver ;;
	*) powerprofilesctl set balanced ;;
	esac
fi

case $(powerprofilesctl get 2>/dev/null) in
power-saver) icon "$LAYOUT" "$(printf '')" ;;
balanced) icon "$OK" "$(printf '')" ;;
performance) icon "#ffa066" "$(printf '')" ;;
*) icon "$INACTIVE" "$(printf '')" ;;
esac
