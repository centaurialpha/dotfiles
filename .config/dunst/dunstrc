# Same palette and font as qtile and dmenu

[global]
    monitor = 0
    follow = none
    width = 400
    height = (0, 150)
    origin = top-right
    offset = (30, 60)
    padding = 8
    horizontal_padding = 10
    frame_width = 0
    separator_height = 2
    separator_color = "#2a2a2a"
    gap_size = 4
    font = Input Mono 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    stack_duplicates = yes
    hide_duplicate_count = yes
    show_indicators = no
    icon_position = off
    sticky_history = yes
    history_length = 15
    dmenu = /usr/local/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1a1a"
    foreground = "#9a9a9a"
    frame_color = "#555555"
    timeout = 4

[urgency_normal]
    background = "#1a1a1a"
    foreground = "#e8e8e8"
    frame_color = "#1270a8"
    timeout = 10

[urgency_critical]
    # The red title is the only marker
    background = "#1a1a1a"
    foreground = "#e8e8e8"
    format = "<b><span foreground='#e46876'>%s</span></b>\n%b"
    frame_color = "#e46876"
    timeout = 0
